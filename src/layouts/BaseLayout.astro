---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteInfo, toAbsoluteUrl } from "../data/siteInfo.js";
import "../styles/global.css";

const {
  title = "QuizNiva",
  description = "Free beginner-friendly study notes, MCQ quizzes, and answer explanations.",
  currentPath = Astro.url.pathname,
  canonicalPath = currentPath,
  robots = "index, follow, max-image-preview:large",
  structuredData = []
} = Astro.props;

const pageTitle = title === "QuizNiva" ? title : `${title} | QuizNiva`;
const canonicalUrl = toAbsoluteUrl(canonicalPath);
const contentSecurityPolicy = [
  "default-src 'self' https: data: blob:",
  "script-src 'self' https: 'unsafe-inline' 'unsafe-eval'",
  "style-src 'self' https: 'unsafe-inline'",
  "img-src 'self' https: data: blob:",
  "font-src 'self' https: data:",
  "connect-src 'self' https: http:",
  "frame-src 'self' https:",
  "worker-src 'self' https: blob:",
  "child-src 'self' https: blob:",
  "media-src 'self' https: data: blob:",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "upgrade-insecure-requests"
].join("; ");
const baseStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteInfo.name,
    url: siteInfo.url,
    email: siteInfo.email,
    logo: toAbsoluteUrl("/favicon.svg")
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteInfo.name,
    url: siteInfo.url,
    potentialAction: {
      "@type": "SearchAction",
      target: `${siteInfo.url}/search?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  }
];
const allStructuredData = [...baseStructuredData, ...structuredData];
---

<!doctype html>
<html lang="en">
  <head>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KYJF3QMJD1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-KYJF3QMJD1');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteInfo.ownerName} />
    <meta name="robots" content={robots} />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="theme-color" content="#102a2a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
        <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteInfo.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <!-- Load third-party ads only after the application has rendered. delayed popunder -->
    <script is:inline>
      (() => {
        const DEBUG = true;
        const log = (...args) => DEBUG && console.log("[popunder]", ...args);

        const cooldownMs = 60 * 1000;
        const storageKey = "quizNivaMonetagPopunderStartedAt";
        const cookieName = "quiz_niva_monetag_popunder_started_at";

        log("————— page loaded —————");
        log("location:", window.location.pathname);
        log("readyState:", document.readyState);
        log("cookies:", document.cookie || "(none)");

        // Unregister the old Adsterra service worker left over from the previous ad provider.
        // Deleting sw.js from the server does not remove it from returning visitors' browsers.
        if ("serviceWorker" in navigator) {
          navigator.serviceWorker.getRegistrations().then((registrations) => {
            log("service workers found:", registrations.length);
            registrations.forEach((reg) => {
              const url = reg.active?.scriptURL || "";
              log("  sw:", url);
              if (url.includes("5gvci.com")) {
                reg.unregister().then(() => log("  ✓ unregistered old Adsterra SW"));
              }
            });
          }).catch(() => {});
        }

        function readCookie(name) {
          const prefix = `${name}=`;
          const cookie = document.cookie.split("; ").find((item) => item.startsWith(prefix));
          return cookie ? Number(decodeURIComponent(cookie.slice(prefix.length))) || 0 : 0;
        }

        function getPopunderStartedAt() {
          const cookieValue = readCookie(cookieName);

          if (cookieValue) {
            const age = Date.now() - cookieValue;
            log("getPopunderStartedAt: cookie =", cookieValue, `(${(age / 1000).toFixed(1)}s ago)`);
            return cookieValue;
          }

          try {
            const stored = Number(window.localStorage.getItem(storageKey)) || 0;
            // Clean up stale localStorage once the cooldown has passed so the
            // next check sees a clean state without relying on the cookie alone.
            if (stored && Date.now() - stored >= cooldownMs) {
              log("getPopunderStartedAt: localStorage stale, removing (", stored, ")");
              window.localStorage.removeItem(storageKey);
              return 0;
            }
            if (stored) {
              const age = Date.now() - stored;
              log("getPopunderStartedAt: localStorage =", stored, `(${(age / 1000).toFixed(1)}s ago)`);
            }
            return stored;
          } catch {
            return 0;
          }
        }

        function startPopunderCooldown() {
          const startedAt = Date.now();
          log("startPopunderCooldown: setting cooldown at", startedAt, `(${new Date(startedAt).toISOString()})`);
          document.cookie = `${cookieName}=${startedAt}; Max-Age=60; Path=/; SameSite=Lax`;

          try {
            window.localStorage.setItem(storageKey, String(startedAt));
          } catch {
            // The cookie remains available when browser storage is disabled.
          }
        }

        function isPopunderCoolingDown() {
          const startedAt = getPopunderStartedAt();
          const elapsed = Date.now() - startedAt;
          const cooling = elapsed < cooldownMs;

          if (startedAt) {
            const remaining = Math.max(0, (cooldownMs - elapsed) / 1000);
            log("isPopunderCoolingDown:", cooling ? "YES (cooling)" : "NO (expired)",
              `| elapsed: ${(elapsed / 1000).toFixed(1)}s`,
              `| remaining: ${remaining.toFixed(1)}s`);
          } else {
            log("isPopunderCoolingDown: NO (no previous start time)");
          }

          return cooling;
        }

        function appendAdScript(src, zone) {
          log("appendAdScript: loading", src, "zone:", zone);
          const script = document.createElement("script");
          script.async = true;
          script.dataset.zone = zone;
          script.dataset.cfasync = "false";
          script.src = src;
          (document.body || document.documentElement).appendChild(script);
        }

        let cooldownTimer = null;

        // Heartbeat: log cooldown status every 5 seconds so you can watch the
        // countdown without waiting for the timer to fire.
        const heartbeatInterval = setInterval(() => {
          const startedAt = getPopunderStartedAt();
          if (!startedAt) {
            log("heartbeat: no cooldown set yet");
            return;
          }
          const elapsed = Date.now() - startedAt;
          const remaining = Math.max(0, cooldownMs - elapsed);
          const cooling = elapsed < cooldownMs;
          log("heartbeat:", cooling ? "COOLING" : "EXPIRED",
            `| elapsed: ${(elapsed / 1000).toFixed(1)}s`,
            `| remaining: ${(remaining / 1000).toFixed(1)}s`);
        }, 5000);

        function scheduleNextPopunder() {
          if (cooldownTimer) {
            clearTimeout(cooldownTimer);
            cooldownTimer = null;
          }

          const startedAt = getPopunderStartedAt();
          if (!startedAt) {
            // No cooldown has ever been set — loadAds() will handle it on the next
            // page load. Nothing to schedule here.
            return;
          }

          const elapsed = Date.now() - startedAt;
          const remaining = Math.max(0, cooldownMs - elapsed);

          log("scheduleNextPopunder: retry in", (remaining / 1000).toFixed(1) + "s");
          cooldownTimer = setTimeout(() => {
            log("scheduleNextPopunder: timer fired");
            cooldownTimer = null;
            loadAds();
          }, remaining);
        }

        function loadAds() {
          log("loadAds() called");
          if (!isPopunderCoolingDown()) {
            log("→ loading popunder ad");
            appendAdScript("https://al5sm.com/tag.min.js", "11553112");
            // Start the cooldown immediately once the script is appended — the
            // popunder fires independently of clicks, so the cooldown must track
            // the append time, not the first user interaction.
            startPopunderCooldown();
            // Schedule the next popunder after the cooldown expires, so the user
            // does not need to click or navigate for a new popunder opportunity.
            scheduleNextPopunder();
          } else {
            log("→ skipped (cooldown active), scheduling retry");
            scheduleNextPopunder();
          }
        }

        if (document.readyState === "complete") {
          window.setTimeout(loadAds, 0);
        } else {
          window.addEventListener("load", loadAds, { once: true });
        }
      })();
    </script>
    <!-- in page push -->
    <script>(function(s){s.dataset.zone='11553122',s.src='https://nap5k.com/tag.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>
    <!-- vingette -->
    <script>(function(s){s.dataset.zone='11553123',s.src='https://n6wxm.com/vignette.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>

    {allStructuredData.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
    <script is:inline>
      (() => {
        const storageKey = "quizNivaTheme";
        const themeColor = {
          light: "#102a2a",
          dark: "#071312"
        };

        try {
          const savedTheme = window.localStorage.getItem(storageKey);
          const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          const theme = savedTheme === "light" || savedTheme === "dark" ? savedTheme : systemTheme;

          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          document.querySelector("meta[name='theme-color']")?.setAttribute("content", themeColor[theme]);
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header currentPath={currentPath} />
    <main id="main">

      <slot />
    </main>
      
    <Footer />
  </body>
</html>
