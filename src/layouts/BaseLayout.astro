---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteInfo, toAbsoluteUrl } from "../data/siteInfo.js";
import "../styles/global.css";

const {
  title = "QuizNiva",
  description = "Free beginner-friendly study notes, MCQ quizzes, and answer explanations.",
  currentPath = Astro.url.pathname,
  canonicalPath = currentPath,
  robots = "index, follow, max-image-preview:large",
  structuredData = [],
  isQuizPage = false
} = Astro.props;

const pageTitle = title === "QuizNiva" ? title : `${title} | QuizNiva`;
const canonicalUrl = toAbsoluteUrl(canonicalPath);
const contentSecurityPolicy = [
  "default-src 'self' https: data: blob:",
  "script-src 'self' https: 'unsafe-inline' 'unsafe-eval'",
  "style-src 'self' https: 'unsafe-inline'",
  "img-src 'self' https: data: blob:",
  "font-src 'self' https: data:",
  "connect-src 'self' https: http:",
  "frame-src 'self' https:",
  "worker-src 'self' https: blob:",
  "child-src 'self' https: blob:",
  "media-src 'self' https: data: blob:",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "upgrade-insecure-requests"
].join("; ");
const baseStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteInfo.name,
    url: siteInfo.url,
    email: siteInfo.email,
    logo: toAbsoluteUrl("/favicon.svg")
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteInfo.name,
    url: siteInfo.url,
    potentialAction: {
      "@type": "SearchAction",
      target: `${siteInfo.url}/search?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  }
];
const allStructuredData = [...baseStructuredData, ...structuredData];
---

<!doctype html>
<html lang="en">
  <head>

    <!-- Google tag (gtag.js) -->
    <!-- <script async src="https://www.googletagmanager.com/gtag/js?id=G-KYJF3QMJD1"></script> -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-KYJF3QMJD1');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="referrer" content="no-referrer-when-downgrade" />
    <meta name="description" content={description} />
    <meta name="author" content={siteInfo.ownerName} />
    <meta name="robots" content={robots} />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="theme-color" content="#102a2a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
        <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteInfo.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <!-- popunder -->
    <!-- <script is:inline>(function(s){s.dataset.zone='11553112',s.src='https://al5sm.com/tag.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script> -->
    <!-- in page push -->
    <!-- <script is:inline>(function(s){s.dataset.zone='11553122',s.src='https://nap5k.com/tag.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script> -->
    <!-- vingette -->
    <script is:inline>(function(s){s.dataset.zone='11553123',s.src='https://n6wxm.com/vignette.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>
    {allStructuredData.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
    <script is:inline>
      (() => {
        const storageKey = "quizNivaTheme";
        const themeColor = {
          light: "#102a2a",
          dark: "#071312"
        };

        try {
          const savedTheme = window.localStorage.getItem(storageKey);
          const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          const theme = savedTheme === "light" || savedTheme === "dark" ? savedTheme : systemTheme;

          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          document.querySelector("meta[name='theme-color']")?.setAttribute("content", themeColor[theme]);
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header currentPath={currentPath} />
    <main id="main">

      <slot />
    </main>
      
    <Footer />
      <!-- hill top ads -->
    <script is:inline>
    (function(xiiqa){
    var d = document,
        s = d.createElement('script'),
        l = d.scripts[d.scripts.length - 1];
    s.settings = xiiqa || {};
    s.src = "\/\/candid-revenue.com\/blXVVXskd.G\/l\/0pYKW-cu\/Oe\/mZ9\/uJZRUWlbkkPOTGcbx\/O\/TVUk4UNzzUcntTNVzJEu5LNjTFg_4RMtQr";
    s.async = true;
    s.referrerPolicy = 'no-referrer-when-downgrade';
    l.parentNode.insertBefore(s, l);
    })({})
    </script>
  </body>
</html>
